# Base de datos (SQLite por defecto; en Render usa la DATABASE_URL de Postgres)
DATABASE_URL=sqlite:///./sql_app.db

# Ejemplos PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
# DATABASE_URL=postgres://user:password@host:5432/ecommerce   # Render (se normaliza a psycopg2)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/ecommerce

# CORS: orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,*

# Nombre del proyecto
PROJECT_NAME=E-Commerce API
API_V1_PREFIX=/api/v1

# JWT (cambia SECRET_KEY en producción)
SECRET_KEY=torque-dev-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Storage (imágenes de catálogo)
# Project Settings → API: Project URL + service_role (solo scripts / servidor)
SUPABASE_URL=https://TU-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=repuestos

# Wompi Sandbox (Dashboard → Desarrolladores → Llaves y secretos)
# Sandbox: pub_test_... / prv_test_... / test_events_... / test_integrity_...
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
