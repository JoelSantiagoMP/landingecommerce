# Base de datos (SQLite por defecto; cambia a PostgreSQL/MySQL en producción)
DATABASE_URL=sqlite:///./sql_app.db

# Ejemplos para otros motores:
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ecommerce

# CORS: orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,*

# Nombre del proyecto
PROJECT_NAME=E-Commerce API
API_V1_PREFIX=/api/v1

# JWT (cambia SECRET_KEY en producción)
SECRET_KEY=torque-dev-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
